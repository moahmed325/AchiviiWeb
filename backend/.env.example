# ==============================================================================
# Achivii Backend Environment Variables
# ==============================================================================

# Port the Express server listens on
PORT=5000

# CORS Allowed Origin (defaults to Vite dev server port 5173)
CLIENT_ORIGIN="http://localhost:5173"

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Production / Staging (Supabase PostgreSQL):
# For Supabase, use the pooled connection string (port 6543) or direct connection (port 5432):
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/achivii_db?schema=public"

# Local SQLite Development Option (Zero-Config):
# To use SQLite locally without running a local Postgres container:
# 1. Run: npm run use:sqlite
# 2. Set: DATABASE_URL="file:./dev.db"
# 3. Run: npm run db:push && npm run db:seed
# 4. To switch back to Supabase/PostgreSQL: npm run use:postgres

# ------------------------------------------------------------------------------
# Google Gemini AI Configuration (Structured LLM Layer)
# ------------------------------------------------------------------------------
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/
# If GEMINI_API_KEY is not provided, Achivii automatically falls back to 
# deterministic rule-based algorithms with zero errors or disruption.
GEMINI_API_KEY=""

# Gemini model to target (defaults to gemini-1.5-flash on the free tier)
# Supported options: gemini-1.5-flash, gemini-2.0-flash
GEMINI_MODEL="gemini-1.5-flash"
