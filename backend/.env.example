# ==============================================================================
# Achivii Backend Environment Variables
# ==============================================================================

# Port the Express server listens on
PORT=5000

# CORS Allowed Origin (defaults to Vite dev server port 5173)
CLIENT_ORIGIN="http://localhost:5173"

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL + pgvector â€” required)
# ------------------------------------------------------------------------------
# Postgres is required everywhere, local included. The Golden Rail cache stores goal
# embeddings in a pgvector `vector(768)` column, which SQLite cannot represent â€” so
# there is no SQLite mode. Supabase is recommended since pgvector ships enabled.
#
# IMPORTANT: use the "Session pooler" connection string, NOT "Direct connection".
# Supabase's direct host (db.[project-ref].supabase.co) resolves to IPv6 only, so it is
# unreachable from IPv4-only networks. The session pooler works over IPv4.
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DATABASE_URL=""

# After setting this, run:
#   npx prisma migrate deploy   # applies schema + enables the pgvector extension
#   npm run verify:pgvector     # confirms the extension, column and indexes are live

# ------------------------------------------------------------------------------
# Google Gemini AI Configuration (Structured LLM Layer)
# ------------------------------------------------------------------------------
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/
# If GEMINI_API_KEY is not provided, Achivii automatically falls back to 
# deterministic rule-based algorithms with zero errors or disruption.
GEMINI_API_KEY=""

# Primary structured LLM. New Google AI Studio keys cannot call gemini-2.5-*.
# gemini-3.5-flash-lite: ~500 free RPD, 1M context â€” enough for a 12-week plan.
GEMINI_MODEL="gemini-3.5-flash-lite"

# Optional Groq fallback. Free openai/gpt-oss-120b is 200K tokens/day â€” a few
# custom-goal plans will exhaust it. A daily-limit 429 skips that model only;
# the backup has its own budget.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_BACKUP_MODEL="openai/gpt-oss-20b"

# ------------------------------------------------------------------------------
# Tavily Search API Configuration (Golden Rail Pipeline)
# ------------------------------------------------------------------------------
# Get your Tavily API key from https://tavily.com/ (free tier includes 1,000 requests/mo)
# Tavily is geo-blocked in some regions (including Ethiopia) and returns an HTML 403 there.
# If local calls fail with "403 Forbidden", connect a VPN â€” this affects local dev only.
TAVILY_API_KEY=""

# ------------------------------------------------------------------------------
# Lemon Squeezy Billing (server-only; never expose these to frontend code)
# ------------------------------------------------------------------------------
# Select exactly one provider environment. Defaults to test.
LEMON_SQUEEZY_ENVIRONMENT="test"

# Test-mode credentials/configuration.
LEMON_SQUEEZY_TEST_STORE_ID=""
LEMON_SQUEEZY_TEST_API_KEY=""
LEMON_SQUEEZY_TEST_WEBHOOK_SIGNING_SECRET=""
LEMON_SQUEEZY_TEST_PRO_MONTHLY_VARIANT_ID=""
LEMON_SQUEEZY_TEST_PRO_YEARLY_VARIANT_ID=""

# Live-mode credentials/configuration. Keep empty until production onboarding is complete.
LEMON_SQUEEZY_LIVE_STORE_ID=""
LEMON_SQUEEZY_LIVE_API_KEY=""
LEMON_SQUEEZY_LIVE_WEBHOOK_SIGNING_SECRET=""
LEMON_SQUEEZY_LIVE_PRO_MONTHLY_VARIANT_ID=""
LEMON_SQUEEZY_LIVE_PRO_YEARLY_VARIANT_ID=""

