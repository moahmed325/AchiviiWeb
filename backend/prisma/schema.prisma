datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String?
  auth_user_id  String?  @unique
  timezone      String   @default("UTC")
  created_at    DateTime @default(now())
  // ND-26: the missed-day reminder email. On unless the person turns it off (Account or the email's unsubscribe link).
  remindersEnabled Boolean   @default(true)
  // When the last reminder was sent; one per gap (no new one until a practice day is completed after it).
  lastReminderAt   DateTime?

  goals         Goal[]
  subscriptions Subscription[]

  @@map("users")
}

model Subscription {
  id                     String   @id @default(uuid())
  userId                 String
  provider               String   @default("lemon_squeezy")
  providerCustomerId     String?
  providerSubscriptionId String   @unique
  providerProductId      String?
  providerVariantId      String
  plan                   String
  billingInterval        String
  status                 String
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean  @default(false)
  cancelledAt            DateTime?
  pausedAt               DateTime?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([providerCustomerId])
  @@index([providerVariantId])
  @@map("subscriptions")
}
model WebhookEvent {
  id             String    @id @default(uuid())
  deliveryKey    String    @unique
  eventName      String
  resourceType   String
  resourceId     String
  status         String    @default("RECEIVED")
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?
  processingError String?

  @@index([resourceType, resourceId])
  @@index([status, receivedAt])
  @@map("webhook_events")
}
model Goal {
  id               String         @id @default(uuid())
  userId           String
  rawGoal          String
  clarifiedOutcome String
  methodologyNotes String         @default("")
  status           String         @default("active")
  startDate        DateTime       @default(now())
  targetDate       DateTime
  currentWeek      Int            @default(1)
  answers          String         @default("{}")
  routine          String         @default("{}")
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  completedAt      DateTime?

  isGoldenRail        Boolean   @default(false)
  canonicalMethodName String?
  canonicalAuthority  String?
  canonicalSourceUrl  String?
  methodConfidence    String?   // "high_consensus" | "medium_consensus" | "first_principles"
  methodKind          String?   // "named_program" | "shared_pattern" | "technique" | "single_source"
  planVersion         Int       @default(2) // 2 = roadmap + one week at a time (docs/architecture/plan-v2.md)
  roadmap             Json?     // v2: { finalGoal, finalTest, startingPoint, method, phases }
  // Weekly update (docs/features/weekly-update, WU-21: one additive migration)
  movedDays           Int       @default(0) // RULE-14/15: days gaps and breaks pushed the plan later, max 28
  closeTriedAt        DateTime? // RULE-9: the first open that tried to close week `closeTriedWeek`
  closeTriedWeek      Int?

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapWeeks     RoadmapWeek[]
  dailyTasks       DailyTask[]
  weeklyReviews    WeeklyReview[]

  @@map("goals")
}

model RoadmapWeek {
  id              String   @id @default(uuid())
  goalId          String
  weekNumber      Int
  phase           String
  theme           String
  objective       String
  keyMilestone    String
  targetIntensity Int      @default(60)
  plannedMinutes  Int      @default(30)
  status          String   @default("pending")
  executionScore  Float?
  reviewNotes     String?
  target          Json?    // v2: { kind: "number", metric, value, unit, direction } | { kind: "deliverable", description }
  test            Json?    // v2: { type, instructions, passIf }
  testResult      Json?
  // Weekly update (WU-21)
  closedBy        String?   // 'review' | 'auto' | 'jumped'
  closedAt        DateTime?
  jumped          Boolean   @default(false) // RULE-15
  breakDays       Int?      // on the first week back: the break's length in days (RULE-13)
  updateStatus    String?   // 'on_track' | 'a_bit_behind' | 'far_behind' (RULE-3), never shown
  retestOfWeek    Int?      // RULE-5: this week's first day re-tests that week
  dailyTimeAskedAt DateTime? // RULE-6
  closeLineSeenAt DateTime? // WU-28: the close's line was shown once
  created_at      DateTime @default(now())

  goal            Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, weekNumber])
  @@map("roadmap_weeks")
}

model DailyTask {
  id                      String    @id @default(uuid())
  goalId                  String
  weekNumber              Int
  dayNumber               Int
  date                    String
  dayOfWeek               String    @default("Monday")
  title                   String
  detailedSteps           String
  implementationIntention String
  durationMinutes         Int       @default(30)
  slotTime                String?
  isRestDay               Boolean   @default(false)
  status                  String    @default("pending")
  completedAt             DateTime?
  notes                   String?
  resourceTitle           String?
  resourceUrl             String?
  resourceType            String?
  resourceWhy             String?
  isKeySession            Boolean   @default(false)
  isTestDay               Boolean   @default(false)
  whyToday                String?
  minimumVersion          Json?     // v2: the 10-minute step for days the full session won't happen
  usedMinimumVersion      Boolean   @default(false) // ND-3: completed only through the 10-minute version
  notOffered              Boolean   @default(false) // WU-13: passed before its week was written; never missed
  created_at              DateTime  @default(now())

  goal                    Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, weekNumber])
  @@map("daily_tasks")
}

model WeeklyReview {
  id                  String   @id @default(uuid())
  goalId              String
  weekNumber          Int
  tasksPlanned        Int
  tasksCompleted      Int
  scorePercentage     Float
  reflection          String?
  aiAdaptationInsight String?
  created_at          DateTime @default(now())

  goal                Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, weekNumber])
  @@map("weekly_reviews")
}
