datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  timezone      String   @default("UTC")
  created_at    DateTime @default(now())

  goals         Goal[]

  @@map("users")
}

model Goal {
  id               String         @id @default(uuid())
  userId           String
  rawGoal          String
  clarifiedOutcome String
  methodologyNotes String         @default("")
  status           String         @default("active")
  startDate        DateTime       @default(now())
  targetDate       DateTime
  currentWeek      Int            @default(1)
  answers          String         @default("{}")
  routine          String         @default("{}")
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapWeeks     RoadmapWeek[]
  dailyTasks       DailyTask[]
  weeklyReviews    WeeklyReview[]

  @@map("goals")
}

model RoadmapWeek {
  id              String   @id @default(uuid())
  goalId          String
  weekNumber      Int
  phase           String
  theme           String
  objective       String
  keyMilestone    String
  targetIntensity Int      @default(60)
  plannedMinutes  Int      @default(30)
  status          String   @default("pending")
  executionScore  Float?
  reviewNotes     String?
  created_at      DateTime @default(now())

  goal            Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, weekNumber])
  @@map("roadmap_weeks")
}

model DailyTask {
  id                      String    @id @default(uuid())
  goalId                  String
  weekNumber              Int
  dayNumber               Int
  date                    String
  dayOfWeek               String    @default("Monday")
  title                   String
  detailedSteps           String
  implementationIntention String
  durationMinutes         Int       @default(30)
  slotTime                String?
  isRestDay               Boolean   @default(false)
  status                  String    @default("pending")
  completedAt             DateTime?
  notes                   String?
  resourceTitle           String?
  resourceUrl             String?
  resourceType            String?
  resourceWhy             String?
  created_at              DateTime  @default(now())

  goal                    Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, weekNumber])
  @@map("daily_tasks")
}

model WeeklyReview {
  id                  String   @id @default(uuid())
  goalId              String
  weekNumber          Int
  tasksPlanned        Int
  tasksCompleted      Int
  scorePercentage     Float
  reflection          String?
  aiAdaptationInsight String?
  created_at          DateTime @default(now())

  goal                Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, weekNumber])
  @@map("weekly_reviews")
}
