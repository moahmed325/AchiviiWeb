datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String?
  auth_user_id  String?  @unique
  timezone      String   @default("UTC")
  created_at    DateTime @default(now())

  // ND-20: legacy Stripe-era billing columns. They still exist in the database (migration
  // 20260928171500_add_user_billing_fields) and are declared here only so the schema matches it.
  // Billing reads `Subscription`. Never use these; dropping them needs its own migration and decision.
  /// @deprecated Legacy, unused (ND-20).
  plan                 String    @default("free")
  /// @deprecated Legacy, unused (ND-20).
  stripeCustomerId     String?   @unique
  /// @deprecated Legacy, unused (ND-20).
  stripeSubscriptionId String?   @unique
  /// @deprecated Legacy, unused (ND-20).
  subscriptionStatus   String?
  /// @deprecated Legacy, unused (ND-20).
  currentPeriodEnd     DateTime?
  /// @deprecated Legacy, unused (ND-20).
  cancelAtPeriodEnd    Boolean   @default(false)

  goals         Goal[]
  subscriptions Subscription[]

  @@map("users")
}

model Subscription {
  id                     String   @id @default(uuid())
  userId                 String
  provider               String   @default("lemon_squeezy")
  providerCustomerId     String?
  providerSubscriptionId String   @unique
  providerProductId      String?
  providerVariantId      String
  plan                   String
  billingInterval        String
  status                 String
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean  @default(false)
  cancelledAt            DateTime?
  pausedAt               DateTime?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([providerCustomerId])
  @@index([providerVariantId])
  @@map("subscriptions")
}
model WebhookEvent {
  id             String    @id @default(uuid())
  deliveryKey    String    @unique
  eventName      String
  resourceType   String
  resourceId     String
  status         String    @default("RECEIVED")
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?
  processingError String?

  @@index([resourceType, resourceId])
  @@index([status, receivedAt])
  @@map("webhook_events")
}
model Goal {
  id               String         @id @default(uuid())
  userId           String
  rawGoal          String
  clarifiedOutcome String
  methodologyNotes String         @default("")
  status           String         @default("active")
  startDate        DateTime       @default(now())
  targetDate       DateTime
  currentWeek      Int            @default(1)
  answers          String         @default("{}")
  routine          String         @default("{}")
  created_at       DateTime       @default(now())
  updated_at       DateTime       @updatedAt
  completedAt      DateTime?

  isGoldenRail        Boolean   @default(false)
  canonicalMethodName String?
  canonicalAuthority  String?
  canonicalSourceUrl  String?
  methodConfidence    String?   // "high_consensus" | "medium_consensus" | "first_principles"
  methodKind          String?   // "named_program" | "shared_pattern" | "technique" | "single_source"
  teachings           Json?     // concrete steps the weekly updater must stay on
  workBlocks          Json?     // { kinds, blocks }: the ranked pieces of work every practice step is built from
  allowedUrls         Json?     // retrieved URLs; later weeks may not invent links
  velocityTable       Json?     // Week 1 -> Week 12 metric matrix, derived from research
  canonicalKey        String?   // hierarchical domain key, e.g. "lang.japanese.jlpt_n3"
  planVersion         Int       @default(1) // 2 = roadmap + one week at a time (docs/architecture/plan-v2.md)
  roadmap             Json?     // v2: { finalGoal, finalTest, startingPoint, method, phases }

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapWeeks     RoadmapWeek[]
  dailyTasks       DailyTask[]
  weeklyReviews    WeeklyReview[]

  @@map("goals")
}

model RoadmapWeek {
  id              String   @id @default(uuid())
  goalId          String
  weekNumber      Int
  phase           String
  theme           String
  objective       String
  keyMilestone    String
  targetIntensity Int      @default(60)
  plannedMinutes  Int      @default(30)
  status          String   @default("pending")
  executionScore  Float?
  reviewNotes     String?
  target          Json?    // v2: { kind: "number", metric, value, unit, direction } | { kind: "deliverable", description }
  test            Json?    // v2: { type, instructions, passIf }
  testResult      Json?
  created_at      DateTime @default(now())

  goal            Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, weekNumber])
  @@map("roadmap_weeks")
}

model DailyTask {
  id                      String    @id @default(uuid())
  goalId                  String
  weekNumber              Int
  dayNumber               Int
  date                    String
  dayOfWeek               String    @default("Monday")
  title                   String
  detailedSteps           String
  implementationIntention String
  durationMinutes         Int       @default(30)
  slotTime                String?
  isRestDay               Boolean   @default(false)
  status                  String    @default("pending")
  completedAt             DateTime?
  notes                   String?
  resourceTitle           String?
  resourceUrl             String?
  resourceType            String?
  resourceWhy             String?
  isKeySession            Boolean   @default(false)
  isTestDay               Boolean   @default(false)
  whyToday                String?
  minimumVersion          Json?     // v2: the 10-minute step for days the full session won't happen
  usedMinimumVersion      Boolean   @default(false) // ND-3: completed only through the 10-minute version
  created_at              DateTime  @default(now())

  goal                    Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, weekNumber])
  @@map("daily_tasks")
}

model WeeklyReview {
  id                  String   @id @default(uuid())
  goalId              String
  weekNumber          Int
  tasksPlanned        Int
  tasksCompleted      Int
  scorePercentage     Float
  reflection          String?
  aiAdaptationInsight String?
  created_at          DateTime @default(now())

  goal                Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, weekNumber])
  @@map("weekly_reviews")
}

// Unused: written and read only by the removed live research pipeline. Kept, with its
// migrations, until dropping the table is decided separately.
model ResearchCache {
  id                String   @id @default(uuid())
  canonicalKey      String   @unique          // e.g. "lang.japanese.jlpt_n3"
  // pgvector column. Prisma Client cannot read or write Unsupported types; the removed
  // cache code accessed it through raw SQL.
  outcomeEmbedding  Unsupported("vector(768)")?
  canonicalMethod   Json                      // { methodName, authority, sourceUrl, confidence, velocityTable, rawFindings }
  hitCount          Int      @default(1)
  userFeedbackScore Float?                   // populated once a feedback mechanism exists; nullable until then
  readyForPromotion Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lastUsedAt        DateTime @default(now())

  @@map("research_cache")
}
