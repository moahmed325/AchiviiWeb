{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "outputDirectory": "dist",
  "env": {
    "VITE_API_BASE_URL": "https://achivii-api.onrender.com",
    "VITE_API_URL": "https://achivii-api.onrender.com"
  },
  "build": {
    "env": {
      "VITE_API_BASE_URL": "https://achivii-api.onrender.com",
      "VITE_API_URL": "https://achivii-api.onrender.com"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
