# ==============================================================================
# Achivii Frontend Environment Variables
# ==============================================================================

# Backend API Base URL
# Development: http://localhost:5000
# Production: https://your-backend-service.onrender.com
VITE_API_BASE_URL="http://localhost:5000"

# Supabase browser client
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# "Continue with Google" on sign-in and sign-up (B-15). Off unless exactly "true"; turn on once the Google app is published.
VITE_GOOGLE_SIGN_IN_ENABLED="false"
